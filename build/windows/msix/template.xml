<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="GSuite"
        Arguments=""
        InstallLocation="C:\Program Files\MorenoLand\GSuite">
    </Installer>
    <PackageInformation
        PackageName="GSuite"
        PackageDisplayName="GSuite"
        PublisherName="CN=MorenoLand"
        PublisherDisplayName="MorenoLand"
        Version="0.1.84.0"
        PackageDescription="GSuite desktop editor">
        <Capabilities>
            <Capability Name="runFullTrust" />

        </Capabilities>
        <Applications>
            <Application
                Id="com.morenoland.gsuite"
                Description="GSuite desktop editor"
                DisplayName="GSuite"
                ExecutableName="GSuite"
                EntryPoint="Windows.FullTrustApplication">

            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>GSuite</DisplayName>
            <PublisherDisplayName>MorenoLand</PublisherDisplayName>
            <Description>GSuite desktop editor</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="gsuite.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
